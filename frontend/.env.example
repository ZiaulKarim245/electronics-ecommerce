# ==============================================================================
# ENVIRONMENT SETUP (Production vs Local)
# ==============================================================================
# For local dev: Next.js automatically loads `.env.local`.
# For production: Add these variables to your hosting dashboard (e.g., Vercel) 
# or use a `.env.production` file.

# API & Security (Server-only)
# [PRODUCTION]: Must be your live backend URL (e.g., https://api.yourdomain.com/api)
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api

# [PRODUCTION]: Must match FRONTEND_API_KEY in your backend .env exactly!
FRONTEND_API_KEY=replace-with-a-long-random-secret

# [PRODUCTION]: Keep false
STOREFRONT_MOCK_DATA=false

# Public Storefront Details (Client & Server)
# Note: NEXT_PUBLIC_ values are visible in the browser; NEVER place secrets here.
NEXT_PUBLIC_STORE_NAME="TechHub Bangladesh"
NEXT_PUBLIC_LEGAL_NAME="TechHub Electronics Ltd."
NEXT_PUBLIC_SUPPORT_PHONE="+8801XXXXXXXXX"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="+8801XXXXXXXXX"
NEXT_PUBLIC_STORE_ADDRESS="123 Example Street, Dhaka"
NEXT_PUBLIC_BUSINESS_HOURS="9:00 AM - 8:00 PM"
NEXT_PUBLIC_TRADE_LICENSE=""

# Local Business Portal Demo (Development Only)
# [PRODUCTION]: MUST BE FALSE
BUSINESS_DEMO_MODE=false
BUSINESS_DEMO_EMAIL=admin@techhub.test
BUSINESS_DEMO_PASSWORD=change-this-local-demo-password
BUSINESS_DEMO_SESSION_TOKEN=change-this-local-demo-session-token
