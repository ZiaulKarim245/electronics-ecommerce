APP_NAME="TechHub API"
# [PRODUCTION]: Must be "production"
APP_ENV=local
# [PRODUCTION]: Generate via `php artisan key:generate`
APP_KEY=
# [PRODUCTION]: MUST be false
APP_DEBUG=true
APP_TIMEZONE=UTC
# [PRODUCTION]: Must be your live backend URL (e.g., https://api.yourdomain.com)
APP_URL=http://127.0.0.1:8000

# [PRODUCTION]: Must be your live frontend URL (e.g., https://yourdomain.com)
FRONTEND_URL=http://localhost:3000
BUSINESS_PORTAL_URL=http://localhost:3001
# [PRODUCTION]: Generate a secure random 32+ char string and match with frontend
FRONTEND_API_KEY=replace-with-the-same-long-random-secret-as-nextjs

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=electronics_ecommerce
DB_USERNAME=electronics_app
# [PRODUCTION]: Use a strong, secure password
DB_PASSWORD=replace-with-a-strong-local-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
